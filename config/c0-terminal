#!/bin/sh
# Start the local or remote tmux environment used by Claude0. All durable choices
# live in the single user-editable config.json; CLI arguments are transient.

PATH="/opt/homebrew/bin:/usr/local/bin:$HOME/.local/bin:$HOME/.bun/bin:/usr/bin:/bin:${PATH:-}"
export PATH

config_file="$HOME/.config/c0/config.json"

usage() {
  cat <<'EOF'
Usage: c0 terminal [local|remote|status]

With no argument, uses terminal.defaultTarget from ~/.config/c0/config.json.
Edit the file shown by: c0 config
EOF
}

command -v jq >/dev/null 2>&1 || {
  printf 'jq is required to read %s.\n' "$config_file" >&2
  exit 127
}
[ -r "$config_file" ] || {
  printf 'Claude0 config is missing. Run: c0 setup\n' >&2
  exit 2
}

read_json() {
  filter=$1
  fallback=$2
  value=$(jq -er "$filter" "$config_file" 2>/dev/null) || value=$fallback
  printf '%s' "$value"
}

command=${1:-}
case "$command" in
  status)
    printf 'default_target=%s\n' "$(read_json '.terminal.defaultTarget' local)"
    printf 'remote_host=%s\n' "$(read_json '.terminal.remoteHost // "<unset>"' '<unset>')"
    printf 'local_session=%s\n' "$(read_json '.terminal.localSession' main)"
    printf 'remote_session=%s\n' "$(read_json '.terminal.remoteSession' main)"
    exit 0
    ;;
  local|remote) mode=$command ;;
  -h|--help|help) usage; exit 0 ;;
  '') mode=$(read_json '.terminal.defaultTarget' local) ;;
  *) usage >&2; exit 2 ;;
esac

case "$mode" in
  local)
    session=${CLAUDE0_LOCAL_TMUX_SESSION:-$(read_json '.terminal.localSession' main)}
    command -v tmux >/dev/null 2>&1 || {
      printf 'tmux is required for local Claude0 mode.\n' >&2
      exit 127
    }
    tmux new-session -A -s "$session"
    ;;
  remote)
    host=${CLAUDE0_REMOTE_HOST:-$(read_json '.terminal.remoteHost // empty' '')}
    session=${CLAUDE0_REMOTE_TMUX_SESSION:-$(read_json '.terminal.remoteSession' main)}
    [ -n "$host" ] || {
      printf 'No remote host configured. Edit terminal.remoteHost in %s.\n' "$config_file" >&2
      exit 2
    }
    command -v mosh >/dev/null 2>&1 || {
      printf 'Mosh is required for remote Claude0 mode.\n' >&2
      exit 127
    }
    mosh --predict=always \
      --server='env MOSH_SERVER_NETWORK_TMOUT=2592000 mosh-server' \
      "$host" -- tmux new-session -A -s "$session"
    ;;
esac
