[Unit]
Description=CSM monitor fallback for detached tmux
After=tmux.service
BindsTo=tmux.service

[Service]
Environment=PATH=%h/.bun/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# tmux runs status-right's `#(csm status)` only while a client is attached — but a
# headless host's steady state is detached, which is exactly when transition pushes
# matter most. This loop ticks the monitor ONLY when no client is attached, so the
# two tick sources never run concurrently.
ExecStart=/bin/bash -c 'while true; do if [ -z "$(tmux list-clients 2>/dev/null)" ]; then csm status >/dev/null 2>&1; fi; sleep 3; done'
Restart=always
RestartSec=5s

[Install]
WantedBy=default.target
